    "Popover mode shows clipboard as a dropdown attached to the clipboard button." : {
      "comment" : "A description of the \"Popover mode\" in the Clipboard Settings view.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "팝오버 모드는 클립보드 버튼에 연결된 드롭다운 형식으로 클립보드를 표시합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De popover-modus toont het klembord als een vervolgkeuzelijst die aan de klembordknop is gekoppeld."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O modo popover mostra a área de transferência como um menu suspenso anexado ao botão da área de transferência."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всплывающее окно"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "โหมดป๊อปโอเวอร์แสดงคลิปบอร์ดเป็นดรอปดาวน์ติดกับปุ่มคลิปบอร์ด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Açılır pencere modu, panoyu pano düğmesine eklenmiş bir açılır menü olarak gösterir."
          }
        }
      }
    },
    "Popover mode shows color picker as a dropdown attached to the color picker button. Panel mode shows color picker in a floating window." : {
      "extractionState" : "stale",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "팝오버 모드는 색상 선택기 버튼에 연결된 드롭다운 형식으로 색상 선택기를 표시합니다. 패널 모드는 플로팅 윈도우에 색상 선택기를 표시합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De popover-modus toont de kleurkiezer als een vervolgkeuzelijst die aan de kleurkiezerknop is gekoppeld. Paneelmodus toont de kleurkiezer in een zwevend venster."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O modo popover mostra o seletor de cores como um menu suspenso anexado ao botão do seletor de cores. O modo painel mostra o seletor de cores em uma janela flutuante."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поведение отображения пипетки."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "โหมดป๊อปโอเวอร์แสดงตัวเลือกสีเป็นดรอปดาวน์ติดกับปุ่มตัวเลือกสี โหมดแผงแสดงตัวเลือกสีในหน้าต่างลอย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Açılır pencere modu, renk seçici düğmesine bağlı bir açılır menü olarak renk seçiciyi gösterir. Panel modu, yüzen bir pencerede renk seçiciyi gösterir."
          }
        }
      }
    },
    "Popover mode shows the assistant as a dropdown attached to the AI button. Panel mode shows the assistant in a floating window near the notch." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "팝오버 모드는 AI 버튼에 연결된 드롭다운 형식으로 어시스턴트를 표시합니다. 패널 모드는 노치 근처의 플로팅 윈도우에 어시스턴트를 표시합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De popover-modus toont de assistent als een vervolgkeuzelijst die aan de AI-knop is gekoppeld. Paneelmodus toont de assistent in een zwevend venster nabij de inkeping."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O modo Popover mostra o assistente como um menu suspenso conectado ao botão AI. O modo painel mostra o assistente em uma janela flutuante perto do notch."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поведение отображения ИИ помощника."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "โหมดป๊อปโอเวอร์แสดงผู้ช่วยเป็นดรอปดาวน์ติดกับปุ่ม AI โหมดแผงแสดงผู้ช่วยในหน้าต่างลอยใกล้รอยบาก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Açılır pencere modu, asistanı AI düğmesine bağlı bir açılır menü olarak gösterir. Panel modu, asistanı çentiğin yakınındaki yüzen bir pencerede gösterir."
          }
        }
