    "Findings from ADR's scans and Kannu's own checks show here." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تظهر هنا نتائج فحوصات ADR وفحوصات Kannu الخاصة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zde se zobrazí zjištění ze skenů ADR a z vlastních kontrol Kannu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Befunde aus den Scans von ADR und den eigenen Prüfungen von Kannu erscheinen hier."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Findings from ADR's scans and Kannu's own checks show here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquí aparecen los hallazgos de los análisis de ADR y de las comprobaciones propias de Kannu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les constats des analyses d’ADR et des vérifications propres à Kannu s’affichent ici."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az ADR vizsgálatainak és a Kannu saját ellenőrzéseinek észlelései itt jelennek meg."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qui compaiono i rilevamenti delle scansioni di ADR e dei controlli di Kannu."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ADR 검사와 Kannu 자체 점검에서 발견한 사항이 여기에 표시됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bevindingen uit de scans van ADR en de eigen controles van Kannu verschijnen hier."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutaj pojawiają się ustalenia ze skanów ADR i własnych kontroli Kannu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os achados das verificações do ADR e das checagens do próprio Kannu aparecem aqui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Здесь появляются находки сканирований ADR и собственных проверок Kannu."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สิ่งที่พบจากการสแกนของ ADR และการตรวจสอบของ Kannu เองจะแสดงที่นี่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ADR taramalarının ve Kannu'nun kendi denetimlerinin bulguları burada görünür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тут з’являються знахідки зі сканувань ADR і власних перевірок Kannu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ADR 扫描和 Kannu 自身检查的发现会显示在这里。"
          }
        }
      }
