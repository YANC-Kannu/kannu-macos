    "How long the pointer rests before the notch opens." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المدة التي يبقى فيها المؤشر ثابتًا قبل أن يُفتح الشق."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jak dlouho kurzor setrvá na místě, než se notch otevře."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie lange der Zeiger stillsteht, bevor sich die Notch öffnet."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How long the pointer rests before the notch opens."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiempo que el puntero permanece quieto antes de que se abra el notch."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durée d’immobilité du pointeur avant l’ouverture de l’encoche."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mennyi ideig marad mozdulatlan a mutató, mielőtt a notch megnyílik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per quanto tempo il puntatore resta fermo prima che il notch si apra."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
