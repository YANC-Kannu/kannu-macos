        }
      }
    },
    "Configure how the timer looks inside the closed notch. Progress can render as a ring around the icon or as horizontal bars." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "노치가 닫혔을 때의 타이머 모양을 설정하세요. 진행 상황은 아이콘 주변의 고리 또는 가로 막대 형태로 표시될 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configureer hoe de timer eruitziet in de gesloten inkeping. Vooruitgang kan worden weergegeven als een ring rond het pictogram of als horizontale balken."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configure como o temporizador fica dentro do notch fechado. O progresso pode ser renderizado como um anel ao redor do ícone ou como barras horizontais."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настройте внешний вид таймера в закрытом вырезе."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตั้งค่าลักษณะตัวจับเวลาในรอยบากที่ปิด ความคืบหน้าสามารถแสดงเป็นวงแหวนรอบไอคอนหรือแถบแนวนอน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamanlayıcının kapalı çentik içinde nasıl görüneceğini yapılandırın. İlerleme, simgenin etrafında bir halka veya yatay çubuklar şeklinde oluşturulabilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
