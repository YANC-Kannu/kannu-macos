    "Asks macOS to hide every Kannu window. Some capture tools ignore this." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يطلب من macOS إخفاء كل نوافذ Kannu. بعض أدوات التصوير تتجاهل ذلك."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Požádá macOS o skrytí všech oken Kannu. Některé nástroje pro snímání to ignorují."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bittet macOS, alle Kannu-Fenster auszublenden. Manche Aufnahmetools ignorieren das."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asks macOS to hide every Kannu window. Some capture tools ignore this."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pide a macOS que oculte todas las ventanas de Kannu. Algunas herramientas de captura lo ignoran."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demande à macOS de masquer toutes les fenêtres de Kannu. Certains outils de capture l’ignorent."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Megkéri a macOS-t, hogy rejtse el az összes Kannu-ablakot. Egyes rögzítőeszközök figyelmen kívül hagyják."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiede a macOS di nascondere tutte le finestre di Kannu. Alcuni strumenti di acquisizione lo ignorano."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS에 모든 Kannu 창을 숨기도록 요청합니다. 일부 캡처 도구는 이를 무시합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vraagt macOS alle Kannu-vensters te verbergen. Sommige opnametools negeren dit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prosi macOS o ukrycie wszystkich okien Kannu. Niektóre narzędzia do przechwytywania to ignorują."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pede ao macOS que oculte todas as janelas do Kannu. Algumas ferramentas de captura ignoram isso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
