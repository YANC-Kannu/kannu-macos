    "Moves to the external display; follows the pointer with several." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينتقل إلى الشاشة الخارجية؛ ويتبع المؤشر عند وجود عدة شاشات."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přesune se na externí displej; při více displejích sleduje kurzor."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wechselt zum externen Display; folgt bei mehreren dem Zeiger."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moves to the external display; follows the pointer with several."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasa a la pantalla externa; con varias, sigue al puntero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passe sur l’écran externe ; suit le pointeur s’il y en a plusieurs."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Átmegy a külső kijelzőre; több esetén követi a mutatót."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passa al display esterno; con più display segue il puntatore."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "외부 디스플레이로 이동하며, 여러 대일 때는 포인터를 따라갑니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verplaatst naar het externe scherm; volgt bij meerdere de muisaanwijzer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przenosi się na wyświetlacz zewnętrzny; przy kilku podąża za kursorem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vai para a tela externa; com várias, acompanha o ponteiro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переходит на внешний дисплей; если их несколько, следует за курсором."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ย้ายไปที่จอภายนอก หากมีหลายจอจะตามตัวชี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harici ekrana taşınır; birden fazlaysa imleci izler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переходить на зовнішній дисплей; якщо їх кілька, слідує за курсором."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
