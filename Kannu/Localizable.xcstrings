    "Full Disk Access required" : {
      "extractionState" : "stale",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전체 디스크 접근 권한 필요"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volledige schijftoegang vereist"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
