          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bleibt auf dem gewählten Display, sonst wird das Hauptdisplay verwendet."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stays on your pick; falls back to the main display."
          }
        },
