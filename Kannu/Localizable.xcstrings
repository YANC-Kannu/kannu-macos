    "Disabled while an external display app handles brightness." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "معطّل أثناء تحكّم تطبيق شاشة خارجية في السطوع."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vypnuto, dokud jas řídí aplikace pro externí displej."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deaktiviert, solange eine App für externe Displays die Helligkeit steuert."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disabled while an external display app handles brightness."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactivado mientras una app de pantalla externa controla el brillo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivé tant qu'une app d'écran externe gère la luminosité."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Letiltva, amíg egy külső kijelzőalkalmazás kezeli a fényerőt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disattivato finché un'app per display esterni gestisce la luminosità."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "외부 디스플레이 앱이 밝기를 제어하는 동안에는 사용할 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uitgeschakeld zolang een app voor externe schermen de helderheid regelt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyłączone, gdy jasnością steruje aplikacja zewnętrznego wyświetlacza."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desativado enquanto um app de tela externa controla o brilho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отключено, пока яркостью управляет приложение для внешнего дисплея."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปิดใช้งานขณะที่แอปจอภาพภายนอกควบคุมความสว่าง."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harici ekran uygulaması parlaklığı yönettiği sürece devre dışıdır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вимкнено, поки яскравістю керує застосунок зовнішнього дисплея."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "外接显示器应用控制亮度时不可用。"
          }
        }
      }
    },
    "Disabled while external display brightness integration is active." : {
      "localizations" : {
