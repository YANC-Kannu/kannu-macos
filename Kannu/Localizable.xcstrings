    "This is optional. You can change it any time from the menu bar." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 설정은 선택 사항입니다. 언제든지 메뉴 막대에서 변경할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit is optioneel. Je kunt dit op elk moment wijzigen via de menubalk."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это необязательно. Вы сможете изменить это позже из строки меню."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "นี่เป็นตัวเลือก คุณสามารถเปลี่ยนได้ทุกเมื่อจากแถบเมนู"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu isteğe bağlıdır. İstediğiniz zaman menü çubuğundan değiştirebilirsiniz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这是可选的。您可以随时从菜单栏更改。"
          }
        }
      }
    },
    "This permanently removes every saved note and its attachments." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장된 모든 메모와 첨부 파일이 영구적으로 삭제됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiermee worden elke opgeslagen notitie en de bijbehorende bijlagen permanent verwijderd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso remove permanentemente todas as notas salvas e seus anexos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это необязательный параметр. Вы можете изменить его в любое время в строке меню."
