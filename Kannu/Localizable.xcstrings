    "Stay organized with timer, battery monitoring, and media controls." : {

    },
    "Stays on the built-in display, ignoring others." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبقى على الشاشة المدمجة ويتجاهل الشاشات الأخرى."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zůstává na vestavěném displeji a ostatní ignoruje."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bleibt auf dem integrierten Display und ignoriert andere."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stays on the built-in display, ignoring others."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se queda en la pantalla integrada e ignora las demás."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reste sur l’écran intégré et ignore les autres."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A beépített kijelzőn marad, a többit figyelmen kívül hagyja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resta sul display integrato e ignora gli altri."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내장 디스플레이에만 머물고 다른 디스플레이는 무시합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blijft op het ingebouwde scherm en negeert andere."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozostaje na wbudowanym wyświetlaczu i ignoruje pozostałe."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fica na tela integrada e ignora as demais."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Остаётся на встроенном дисплее, остальные игнорирует."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คงอยู่บนจอในตัวและไม่สนใจจออื่น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yerleşik ekranda kalır, diğerlerini yok sayar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Залишається на вбудованому дисплеї, інші ігнорує."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "固定在内置显示器上，忽略其他显示器。"
          }
        }
      }
    },
    "Stays on your pick; falls back to the main display." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبقى على الشاشة المختارة؛ وإلا يعود إلى الشاشة الرئيسية."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
