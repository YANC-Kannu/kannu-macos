    "Requires a third-party client with API plugin enabled." : {
      "comment" : "Description of a music controller type when it requires a third-party client with an API plugin enabled. | Description of a music controller type when it requires a third-party client with an API plugin enabled. | merge:ko:alt='API 플러그인이 활성화된 타사 클라이언트가 필요합니다.'",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "API 플러그인이 활성화된 서드파티 클라이언트가 필요합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vereist een externe client met ingeschakelde API-plug-in."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Требуется сторонний клиент с включенным API плагином."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ต้องการไคลเอนต์บุคคลที่สามที่เปิดใช้ปลั๊กอิน API"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "API eklentisinin etkin olduğu bir üçüncü taraf istemci gerektirir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要启用 API 插件的第三方客户端。"
          }
        }
      }
    },
    "Requires Accessibility permission so Dynamic Island can intercept the hardware volume keys." : {
      "localizations" : {
        "ko" : {
