    "Acknowledged for a project, but this one belongs to none — acknowledge everywhere to settle it" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم الإقرار لمشروع، لكن هذه النتيجة لا تنتمي إلى أي مشروع — قم بالإقرار بها في كل مكان لحسمها"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potvrzeno pro projekt, ale tento záznam nepatří k žádnému — pro vyřízení potvrďte všude"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für ein Projekt bestätigt, dieser Eintrag gehört aber zu keinem — überall bestätigen, um ihn zu erledigen"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acknowledged for a project, but this one belongs to none — acknowledge everywhere to settle it"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reconocido para un proyecto, pero este no pertenece a ninguno — reconócelo en todas partes para resolverlo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acquitté pour un projet, mais celui-ci n’appartient à aucun — acquittez-le partout pour le régler"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy projekthez nyugtázva, de ez egyikhez sem tartozik — a rendezéshez mindenhol nyugtázni kell"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preso atto per un progetto, ma questo non appartiene a nessuno — prendi atto ovunque per risolverlo"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한 프로젝트에서는 확인했지만 이 항목은 어느 프로젝트에도 속하지 않습니다 — 해결하려면 모든 곳에서 확인하세요"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bevestigd voor één project, maar deze bevinding hoort bij geen enkel project — bevestig overal om af te ronden"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potwierdzono dla projektu, ale ten wpis nie należy do żadnego — potwierdź wszędzie, aby go zamknąć"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reconhecido para um projeto, mas este não pertence a nenhum — reconheça em todos os lugares para resolver"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подтверждено для проекта, но эта запись не относится ни к одному — подтвердите везде, чтобы закрыть её"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รับทราบสำหรับโปรเจกต์หนึ่งแล้ว แต่รายการนี้ไม่ได้อยู่ในโปรเจกต์ใดเลย — รับทราบทุกที่เพื่อให้เรียบร้อย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir proje için onaylandı, ancak bu kayıt hiçbirine ait değil — halletmek için her yerde onaylayın"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Підтверджено для проєкту, але цей запис не належить до жодного — підтвердьте всюди, щоб закрити його"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已为一个项目确认，但此项不属于任何项目 — 全局确认即可解决"
          }
        }
      }
    },
