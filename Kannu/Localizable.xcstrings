    "Smooth transitions blend Green (0–60%), Yellow (60–85%), and Red (85–100%) through the entire fill." : {
      "comment" : "A description of how the color-coding feature works.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전체 채우기 영역에서 초록색(0~60%), 노란색(60~85%), 빨간색(85~100%)이 부드럽게 혼합되어 표시됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vloeiende overgangen laten groen (0–60%), geel (60–85%) en rood (85–100%) door de gehele vulling lopen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transições suaves misturam Verde (0–60%), Amarelo (60–85%) e Vermelho (85–100%) em todo o preenchimento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Плавный переход от зеленого (0-60%) к желтому (60-85%) и красному (85-100%)."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smooth transitions blend Green (0–60%), Yellow (60–85%), and Red (85–100%) through the entire fill."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pürüzsüz geçişler Yeşil (%0–60), Sarı (%60–85) ve Kırmızıyı (%85–100) tüm dolgu boyunca harmanlar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "平滑过渡在整个填充中混合绿色（0-60%）、黄色（60-85%）和红色（85-100%）。"
          }
        }
      }
    },
    "Smooth transitions blend Green (0–60%), Yellow (60–85%), and Red (85–100%) through the entire fill. Adjust gradient behavior from Controls › Dynamic Island." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전체 채우기 영역에서 초록색(0~60%), 노란색(60~85%), 빨간색(85~100%)이 부드럽게 혼합되어 표시됩니다. '제어기 › Dynamic Island'에서 그라데이션 동작을 조정할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vloeiende overgangen laten groen (0–60%), geel (60–85%) en rood (85–100%) door de gehele vulling lopen. Pas het verloopgedrag aan via Bediening ›Dynamic Island."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transições suaves misturam Verde (0–60%), Amarelo (60–85%) e Vermelho (85–100%) em todo o preenchimento. Ajuste o comportamento do gradiente em Controles › Dynamic Island."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Плавный переход от зеленого (0-60%) к желтому (60-85%) и красному (85-100%)."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smooth transitions blend Green (0–60%), Yellow (60–85%), and Red (85–100%) through the entire fill. Adjust gradient behavior from Controls › Dynamic Island."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yumuşak geçişler, tüm dolgu boyunca Yeşil (%0-60), Sarı (%60-85) ve Kırmızıyı (%85-100) harmanlar. Degrade davranışını Kontroller › Dynamic Island'den ayarlayın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "平滑过渡在整个填充中混合绿色（0-60%）、黄色（60-85%）和红色（85-100%）。从控制 › 灵动岛调整渐变行为。"
          }
        }
      }
    },
