    "Beside the notch while timing; the name stays hidden." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بجانب الشق أثناء التوقيت؛ يبقى الاسم مخفيًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vedle notche, dokud časovač běží; název zůstane skrytý."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neben der Notch, solange der Timer läuft; der Name bleibt ausgeblendet."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beside the notch while timing; the name stays hidden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Junto al notch mientras corre el temporizador; el nombre permanece oculto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À côté de l’encoche pendant le décompte ; le nom reste masqué."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A notch mellett, amíg az időzítő fut; a név rejtve marad."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accanto al notch mentre il timer è in funzione; il nome resta nascosto."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "타이머가 작동하는 동안 노치 옆에 표시되며, 이름은 숨겨진 상태로 유지됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naast de inkeping terwijl de timer loopt; de naam blijft verborgen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obok notcha podczas odliczania; nazwa pozostaje ukryta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao lado do notch enquanto o temporizador roda; o nome fica oculto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рядом с вырезом, пока идёт отсчёт; название остаётся скрытым."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ข้างรอยบากขณะจับเวลา โดยชื่อจะยังคงซ่อนอยู่"
          }
        },
        "tr" : {
