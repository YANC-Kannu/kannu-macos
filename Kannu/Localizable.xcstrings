    "Mirrors the toggle found under Lock screen settings so timer-specific workflows can enable or disable the widget without switching tabs." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'잠금 화면' 설정에 있는 토글과 연동되어, 탭을 전환하지 않고도 타이머 전용 워크플로에서 위젯을 활성화하거나 비활성화할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spiegelt de schakelaar onder de instellingen van het vergrendelscherm, zodat timerspecifieke workflows de widget kunnen in- of uitschakelen zonder van tabblad te wisselen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espelha a alternância encontrada nas configurações da tela de bloqueio para que os fluxos de trabalho específicos do temporizador possam ativar ou desativar o widget sem alternar as guias."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дублирует переключатель настроек экрана блокировки для управления виджетом из этой вкладки."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สะท้อนสวิตช์ในการตั้งค่าหน้าจอล็อกเพื่อให้เวิร์กโฟลว์ตัวจับเวลาเปิด/ปิดวิดเจ็ตได้โดยไม่ต้องสลับแท็บ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kilit Ekranı ayarları altında bulunan geçişi yansıtır, böylece zamanlayıcıya özel iş akışları sekmeleri değiştirmeden widget'ı etkinleştirebilir veya devre dışı bırakabilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "镜像锁屏设置中的开关，以便计时器工作流可以无需切换标签页即可启用或禁用小组件。"
          }
        }
      }
    },
    "MM" : {
      "extractionState" : "stale",
