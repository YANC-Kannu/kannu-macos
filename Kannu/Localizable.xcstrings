    "Enable extensions to allow third-party apps to display live activities and lock screen widgets in Kannu." : {
      "comment" : "A footer text that explains the purpose of enabling extensions. | A footer text that explains the purpose of enabling extensions. | merge:ko:alt='타사 앱이 Kannu에서 실시간 현황 및 잠금 화면 위젯을 표시할 수 있도록 확장을 활성화합니다.'",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kannu에서 서드파티 앱의 실시간 현황 및 잠금 화면 위젯을 표시할 수 있도록 확장 프로그램을 활성화하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schakel extensies in zodat apps van derden live activiteiten en vergrendelschermwidgets op Kannu kunnen weergeven."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative extensões para permitir que aplicativos de terceiros exibam atividades ao vivo e widgets de tela de bloqueio no Kannu."
          }
        },
        "ru" : {
          "stringUnit" : {
