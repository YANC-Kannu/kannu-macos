          }
        }
      }
    },
    "Kannu" : {
      "comment" : "The name of the app.",
      "isCommentAutoGenerated" : true
    },
    "Kannu always listens to selected-provider brightness events, and listens to provider volume events only when external volume listener is enabled." : {
      "comment" : "A footer text that explains the behavior of the third-party DDC integration settings. | A footer text that explains the behavior of the third-party DDC integration settings. | merge:ko:alt='Kannu은 항상 선택한 제공자의 밝기 이벤트를 수신하며, 외부 음량 감지가 활성화된 경우에만 제공자의 음량 이벤트를 수신합니다.'",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kannu은 항상 선택된 제공업체의 밝기 이벤트를 감지하며, 외부 음량 감지 기능이 활성화된 경우에만 제공업체의 음량 이벤트를 감지합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kannu luistert altijd naar helderheidsgebeurtenissen van de geselecteerde provider en luistert alleen naar volumegebeurtenissen van de provider als de externe volumelistener is ingeschakeld."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kannu отслеживает яркость от выбранного провайдера, а громкость — только при внешнем контроле."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kannu รับฟังเหตุการณ์ความสว่างจากผู้ให้บริการที่เลือกเสมอ และรับฟังเหตุการณ์ระดับเสียงเมื่อเปิดใช้ตัวรับฟังระดับเสียงภายนอก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kannu, seçili sağlayıcının parlaklık olaylarını her zaman dinler; sağlayıcı ses düzeyi olaylarını ise yalnızca harici ses düzeyi dinleyicisi etkinken dinler."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kannu 始终监听所选提供商的亮度事件，仅在启用外部音量监听器时监听提供商的音量事件。"
          }
        }
      }
    },
    "Kannu can show all your upcoming events in one place. Access to your calendar is needed to display your schedule." : {
      "extractionState" : "stale",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kannu은 예정된 모든 일정을 한곳에 모아 보여줍니다. 일정을 표시하려면 캘린더 접근 권한이 필요합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kannu kan al je aankomende activiteiten op één plek weergeven. Toegang tot je agenda is nodig om je planning te tonen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Kannu pode mostrar todos os seus próximos eventos em um só lugar. O acesso ao seu calendário é necessário para exibir sua agenda."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для отображения расписания нужен доступ к календарю."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kannu สามารถแสดงกิจกรรมที่กำลังจะมาถึงทั้งหมดในที่เดียว ต้องการสิทธิ์เข้าถึงปฏิทินเพื่อแสดงตารางของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kannu, yaklaşan tüm etkinliklerinizi tek bir yerde gösterebilir. Programınızı görüntülemek için takviminize erişim gerekir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
