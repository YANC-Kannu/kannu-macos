    "Right-click the album art on the lock screen to set it as the wallpaper. Right-click again or click the background to restore the original wallpaper. If a canvas is available, Kannu can also keep the same album art + player layout on top of the live canvas." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klik met de rechtermuisknop op de albumhoes op het vergrendelscherm om deze als achtergrond in te stellen. Klik nogmaals met de rechtermuisknop of klik op de achtergrond om de originele achtergrond te herstellen. Als er een canvas beschikbaar is, kan Kannu ook dezelfde albumhoezen en spelerindeling bovenop het live canvas behouden."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คลิกขวาที่ปกอัลบั้มบนหน้าจอล็อกเพื่อตั้งเป็นวอลเปเปอร์ คลิกขวาอีกครั้งหรือคลิกพื้นหลังเพื่อกู้คืนวอลเปเปอร์เดิม หากมี Canvas Kannu สามารถคงปกอัลบั้ม + เลย์เอาต์เครื่องเล่นเดิมไว้บน Canvas สด"
          }
        }
      }
    },
    "Right-click the album art to toggle it as wallpaper." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقر بزر الماوس الأيمن على غلاف الألبوم لتبديل استخدامه كخلفية."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pravým kliknutím na obal alba ho zapnete nebo vypnete jako tapetu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rechtsklick auf das Albumcover schaltet es als Hintergrundbild ein oder aus."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Right-click the album art to toggle it as wallpaper."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic derecho en la carátula para activarla o desactivarla como fondo de pantalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clic droit sur la pochette pour l'activer ou la désactiver comme fond d'écran."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jobb kattintással az albumborítót háttérképként be- vagy kikapcsolhatod."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clic destro sulla copertina per usarla o meno come sfondo."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앨범 아트를 오른쪽 클릭하면 배경화면으로 켜고 끌 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
