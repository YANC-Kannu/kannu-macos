    "Customize how you organize and create notes. Enabling color filtering and search helps manage large lists." : {
      "comment" : "A footer text that describes the purpose of the \"Customize how you organize and create notes\" section in the settings view.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메모를 정리하고 작성하는 방법을 사용자 지정하세요. 색상 필터링과 검색 기능을 활성화하면 방대한 목록을 관리하는 데 도움이 됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas aan hoe je notities ordent en maakt. Door kleurfiltering en zoeken in te schakelen, kun je grote lijsten beheren."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personalize a forma como você organiza e cria notas. Habilitar a filtragem de cores e a pesquisa ajuda a gerenciar listas grandes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настройте организацию и создание заметок. Включение фильтра по цвету и поиска поможет управлять большими списками."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปรับแต่งวิธีจัดระเบียบและสร้างบันทึก การเปิดใช้การกรองสีและการค้นหาช่วยจัดการรายการขนาดใหญ่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notları düzenleme ve oluşturma şeklinizi özelleştirin. Renk filtrelemeyi ve aramayı etkinleştirmek büyük listeleri yönetmenize yardımcı olur."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自定义笔记的组织和创建方式。启用颜色过滤和搜索有助于管理大量列表。"
          }
        }
      }
    },
