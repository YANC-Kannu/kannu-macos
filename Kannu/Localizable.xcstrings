          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отключено при активной интеграции внешнего дисплея — клавиши яркости обрабатываются внешним приложением."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปิดใช้ขณะการผสานรวมจอภายนอกทำงานอยู่ — ปุ่มความสว่างถูกจัดการโดยแอปภายนอก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harici ekran entegrasyonu etkinken devre dışı bırakılır; parlaklık tuşları harici uygulama tarafından yönetilir."
          }
        },
        "zh-Hans" : {
