          }
        }
      }
    },
    "Kannu uses the local `sp_dc` cookie only to request Spotify's internal web-player token and fetch the matching Canvas for the current track." : {
      "comment" : "A description of how the Spotify cookie is used.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kannu gebruikt de lokale `sp_dc` cookie alleen om Spotify's interne webplayer-token op te vragen en het overeenkomende Canvas voor het huidige nummer op te halen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kannu ใช้คุกกี้ `sp_dc` ในเครื่องเพื่อขอโทเค็น Spotify web-player และดึง Canvas ที่ตรงกันสำหรับแทร็กปัจจุบันเท่านั้น"
          }
        }
      }
    },
