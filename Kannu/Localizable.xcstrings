    "Just the essentials for everyday tasks, with fewer features switched on." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일상적인 작업에 꼭 필요한 기능만 제공하며, 켜져 있는 기능이 더 적습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
