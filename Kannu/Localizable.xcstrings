    "Control timer availability, live activity behaviour, and whether the app mirrors timers started from the macOS Clock app." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "타이머 활성화 여부, 실시간 현황 동작, 그리고 macOS '시계' 앱에서 시작된 타이머의 연동 여부를 제어합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beheer de beschikbaarheid van timers, het gedrag van live-activiteiten en of de app timers weerspiegelt die zijn gestart vanuit de macOS Clock-app."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controle a disponibilidade do cronômetro, o comportamento da atividade ao vivo e se o aplicativo espelha os temporizadores iniciados no aplicativo Relógio do MacOS."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Управляет доступностью таймера, Live Activities и тем, дублирует ли приложение таймеры из системного приложения Часы."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ควบคุมการใช้งานตัวจับเวลา พฤติกรรมกิจกรรมสด และว่าแอปจะสะท้อนตัวจับเวลาจากแอป Clock ของ macOS หรือไม่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamanlayıcı kullanılabilirliğini, canlı etkinlik davranışını ve uygulamanın macOS Clock uygulamasından başlatılan zamanlayıcıları yansıtıp yansıtmadığını kontrol edin."
