    },
    "Claude Code, Cursor and Antigravity (untested) refuse matching calls." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يرفض Claude Code وCursor وAntigravity (غير مُختبَر) الاستدعاءات المطابقة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code, Cursor a Antigravity (netestováno) odmítnou odpovídající volání."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code, Cursor und Antigravity (ungetestet) lehnen passende Aufrufe ab."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code, Cursor and Antigravity (untested) refuse matching calls."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code, Cursor y Antigravity (sin probar) rechazan las llamadas que coinciden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
