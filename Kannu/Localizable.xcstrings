    "Drag a control onto a slot or tap to place it in the first empty slot." : {
      "comment" : "A description below the control palette that explains how users can interact with it.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "제어기를 슬롯으로 드래그하거나, 탭하여 첫 번째 빈 슬롯에 배치하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep een besturingselement naar een slot of tik om het in het eerste lege slot te plaatsen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste um controle para um slot ou toque para colocá-lo no primeiro slot vazio."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перетащите элемент в слот или нажмите, чтобы добавить его в первый свободный слот."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลากปุ่มควบคุมไปยังช่องหรือแตะเพื่อวางในช่องว่างแรก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir kontrolü bir yuvaya sürükleyin veya ilk boş yuvaya yerleştirmek için dokunun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将控件拖到插槽上或点击将其放在第一个空插槽中。"
          }
        }
      }
    },
    "Drag items between slots or drop from the palette to remap controls." : {
      "comment" : "A description of how to interact with the music slot configuration view.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "슬롯 간에 항목을 드래그하거나 팔레트에서 드롭하여 제어기를 재배치하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep items tussen slots of zet ze neer uit het palet om de besturingselementen opnieuw toe te wijzen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste itens entre slots ou solte da paleta para remapear os controles."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перетаскивайте элементы между слотами или сбрасывайте их с палитры для изменения управления."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลากรายการระหว่างช่องหรือวางจากจานสีเพื่อจัดเรียงปุ่มควบคุมใหม่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontrolleri yeniden eşlemek için öğeleri yuvalar arasında sürükleyin veya paletten bırakın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在插槽之间拖动项目或从面板中放置以重新映射控件。"
          }
        }
      }
    },
    "Drag the previews to adjust vertical placement; positive values lift the panel. The width sliders narrow the media and timer widgets, never past their default size." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسحب المعاينات لضبط الموضع الرأسي؛ القيم الموجبة ترفع اللوحة. تُضيّق منزلقات العرض أداتَي الوسائط والمؤقّت دون تجاوز حجمهما الافتراضي."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přetažením náhledů upravíte svislou polohu; kladné hodnoty panel zvedají. Posuvníky šířky zúží widgety médií a časovače, nikdy ne nad jejich výchozí velikost."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehe die Vorschauen, um die vertikale Position anzupassen; positive Werte heben das Panel an. Die Breitenregler verengen die Medien- und Timer-Widgets, nie über ihre Standardgröße hinaus."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drag the previews to adjust vertical placement; positive values lift the panel. The width sliders narrow the media and timer widgets, never past their default size."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra las vistas previas para ajustar la posición vertical; los valores positivos suben el panel. Los controles de ancho estrechan los widgets de multimedia y temporizador, nunca más allá de su tamaño predeterminado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser les aperçus pour ajuster la position verticale ; les valeurs positives remontent le panneau. Les curseurs de largeur rétrécissent les widgets média et minuteur, sans dépasser leur taille par défaut."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Húzd az előnézeteket a függőleges elhelyezés beállításához; a pozitív értékek feljebb viszik a panelt. A szélességcsúszkák a média- és időzítő-widgeteket szűkítik, az alapméretnél sosem szélesebbre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina le anteprime per regolare la posizione verticale; i valori positivi alzano il pannello. I cursori della larghezza restringono i widget multimediali e del timer, mai oltre la dimensione predefinita."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "미리보기를 드래그해 세로 위치를 조정하세요. 양수 값은 패널을 위로 올립니다. 너비 슬라이더는 미디어 및 타이머 위젯을 좁혀 주며, 기본 크기를 넘지는 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep de voorvertoningen om de verticale plaatsing aan te passen; positieve waarden tillen het paneel omhoog. De breedteschuifregelaars maken de media- en timerwidgets smaller, nooit groter dan hun standaardformaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przeciągnij podglądy, aby ustawić położenie w pionie; wartości dodatnie unoszą panel. Suwaki szerokości zwężają widżety multimediów i minutnika, nigdy poza ich domyślny rozmiar."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste as prévias para ajustar a posição vertical; valores positivos sobem o painel. Os controles de largura estreitam os widgets de mídia e de timer, nunca além do tamanho padrão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перетаскивайте превью, чтобы настроить положение по вертикали; положительные значения поднимают панель. Ползунки ширины сужают виджеты медиа и таймера, но не делают их шире размера по умолчанию."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลากภาพตัวอย่างเพื่อปรับตำแหน่งแนวตั้ง ค่าบวกจะยกแผงขึ้น. ตัวเลื่อนความกว้างจะทำให้วิดเจ็ตสื่อและตัวจับเวลาแคบลง แต่ไม่เกินขนาดเริ่มต้น."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dikey konumu ayarlamak için önizlemeleri sürükleyin; pozitif değerler paneli yukarı kaldırır. Genişlik kaydırıcıları medya ve zamanlayıcı widget'larını daraltır, varsayılan boyutlarını asla aşmaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перетягуйте попередні перегляди, щоб налаштувати положення по вертикалі; додатні значення піднімають панель. Повзунки ширини звужують віджети медіа й таймера, але не роблять їх ширшими за типовий розмір."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖动预览可调整垂直位置，正值会抬高面板。宽度滑块可缩窄媒体和计时器小组件，但不会超过其默认大小。"
          }
        }
      }
    },
