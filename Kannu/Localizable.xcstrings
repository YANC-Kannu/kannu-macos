    "High-frequency updates without a timeout can increase battery usage." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시간 제한 없는 빈번한 업데이트는 배터리 사용량을 증가시킬 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
