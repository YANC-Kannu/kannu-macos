    "Push alerts through ntfy, Pushover or a webhook. Public ntfy topics can be read by anyone unless you self-host." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أرسل تنبيهات فورية عبر ntfy أو Pushover أو webhook. يمكن لأي شخص قراءة موضوعات ntfy العامة ما لم تستضفها بنفسك."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posílejte upozornění přes ntfy, Pushover nebo webhook. Veřejná témata ntfy může číst kdokoli, pokud je nehostujete sami."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Push-Benachrichtigungen über ntfy, Pushover oder einen Webhook. Öffentliche ntfy-Topics kann jeder lesen, außer du hostest selbst."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Push alerts through ntfy, Pushover or a webhook. Public ntfy topics can be read by anyone unless you self-host."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envía alertas push con ntfy, Pushover o un webhook. Cualquiera puede leer los temas públicos de ntfy, salvo que los alojes tú."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoyez des alertes push via ntfy, Pushover ou un webhook. Les sujets ntfy publics sont lisibles par tous, sauf si vous les hébergez vous-même."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Push-értesítések ntfy, Pushover vagy webhook útján. A nyilvános ntfy-témákat bárki olvashatja, hacsak nem saját szerveren üzemelteted."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invia avvisi push tramite ntfy, Pushover o un webhook. Gli argomenti ntfy pubblici sono leggibili da chiunque, a meno che tu non li ospiti in proprio."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ntfy, Pushover 또는 webhook으로 푸시 알림을 보냅니다. 공개 ntfy 토픽은 직접 호스팅하지 않으면 누구나 읽을 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuur pushmeldingen via ntfy, Pushover of een webhook. Openbare ntfy-topics kan iedereen lezen, tenzij je zelf host."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wysyłaj powiadomienia push przez ntfy, Pushover lub webhook. Publiczne tematy ntfy może czytać każdy, chyba że hostujesz je samodzielnie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envie alertas push via ntfy, Pushover ou webhook. Qualquer pessoa pode ler tópicos públicos do ntfy, a menos que você os hospede por conta própria."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Push-уведомления через ntfy, Pushover или webhook. Публичные темы ntfy может читать любой, если вы не размещаете сервер у себя."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ส่งการแจ้งเตือนแบบพุชผ่าน ntfy, Pushover หรือ webhook. หัวข้อ ntfy สาธารณะใครก็อ่านได้ เว้นแต่คุณโฮสต์เอง."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anlık bildirimleri ntfy, Pushover veya bir webhook ile gönderin. Herkese açık ntfy konularını, kendiniz barındırmadıkça herkes okuyabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Push-сповіщення через ntfy, Pushover або webhook. Публічні теми ntfy може читати будь-хто, якщо ви не розміщуєте їх самі."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过 ntfy、Pushover 或 webhook 推送提醒。公开的 ntfy 主题任何人都能读取，除非你自行托管。"
          }
        }
      }
    },
