#!/usr/bin/env bash
set -euo pipefail

# --- Local denylist -----------------------------------------------------------
# Real work data never lands in this public repo: fixtures, tests, comments and CHANGELOG lines use
# made-up data only (AGENTS.md, Security and privacy). The names to refuse live in an untracked,
# local file, so the list itself is never published: <git-common-dir>/info/kannu-denylist, one
# case-insensitive fixed string per line, # for comments. No file, no check. It runs before the merge
# exemption below, so a conflict resolution is checked too. The report names files, never the matched
# text, which would otherwise end up in logs and transcripts.
# It fails closed: every git step writes a file outside any condition, so an error stops the hook
# (set -e) instead of reading as "no match", and grep's own errors refuse the commit too.
deny_dir="$(git rev-parse --git-common-dir)/info"
denylist="${deny_dir}/kannu-denylist"
# A missing list is no check, but a folder that cannot be searched hides whether there is one, so it refuses.
if [[ -e "${deny_dir}" && ! ( -d "${deny_dir}" && -x "${deny_dir}" ) ]]; then
  echo "ERROR: cannot look for the denylist in ${deny_dir}; refusing the commit."
  exit 1
fi
if [[ -s "${denylist}" ]]; then
  deny_work="$(mktemp -d)"
  trap 'rm -rf "${deny_work}"' EXIT
  # 1 means the list has no names, which is no check; any other failure (an unreadable list) refuses.
  deny_rc=0
  grep -v -e '^[[:space:]]*#' -e '^[[:space:]]*$' "${denylist}" > "${deny_work}/patterns" || deny_rc=$?
  if (( deny_rc > 1 )); then echo "ERROR: could not read the denylist (${denylist}); refusing the commit."; exit 1; fi
  if [[ -s "${deny_work}/patterns" ]]; then
    # The objects being committed, not what replacement refs (refs/replace/*) would substitute.
    export GIT_NO_REPLACE_OBJECTS=1
    # 0: the file holds a listed name; 1: it does not. Anything else is a failed scan.
    deny_matches() {
      local rc=0
      grep -i -F -q -f "${deny_work}/patterns" -- "$1" || rc=$?
      if (( rc > 1 )); then echo "ERROR: the denylist scan failed (grep exit ${rc}); refusing the commit."; exit 1; fi
      return "${rc}"
    }
    # The added lines of a diff. A file's header, from its "diff --git" (or --cc) line to its first hunk,
    # is skipped whole, so a quoted or unusual path in it is never read as an added line.
    added_lines() { awk '/^diff --(git|cc|combined) /{h=1} /^@@/{h=0; next} h{next} /^\+/{print}'; }
    deny_files=""
    # NUL-delimited and literal: a quoted path (core.quotePath) or one that reads as pathspec magic
    # would otherwise name the wrong file. T covers a symlink that became a file. Raw content only:
    # no external diff and no textconv, which could fail or rewrite what is scanned, and --text, so a
    # file an attribute marks -diff or binary still shows its added lines.
    git diff --cached --name-only -z --diff-filter=ACMRT > "${deny_work}/paths"
    while IFS= read -r -d '' f; do
      git --literal-pathspecs diff --cached -U0 --no-color --no-ext-diff --no-textconv --text -- "$f" > "${deny_work}/diff"
      added_lines < "${deny_work}/diff" > "${deny_work}/added"
      if deny_matches "${deny_work}/added"; then deny_files+="  ${f}"$'\n'; fi
    done < "${deny_work}/paths"
    { git var GIT_AUTHOR_IDENT; git var GIT_COMMITTER_IDENT; } > "${deny_work}/ident"
    deny_ident=""
    if deny_matches "${deny_work}/ident"; then deny_ident=1; fi
    if [[ -n "${deny_files}" || -n "${deny_ident}" ]]; then
      echo "ERROR: this commit matches the local denylist (${denylist})."
      if [[ -n "${deny_files}" ]]; then printf 'Added lines in:\n%s' "${deny_files}"; fi
      if [[ -n "${deny_ident}" ]]; then echo "The author or committer identity matches it too (check user.email)."; fi
      echo "Use made-up data instead (acme, example.com, PROJ-123): AGENTS.md, Security and privacy."
      exit 1
    fi
  fi
fi

# Merges skip every check below; the denylist above has already run.
if git rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1; then
  exit 0
fi

# --- Hook-script mirror drift -------------------------------------------------
# AgentHookInstaller.swift embeds the authoritative hook script;
# scripts/kannu-agent-status.sh is a generated mirror that install-cursor-hooks.sh
# copies to users. They have silently drifted three times (see docs/REGRESSIONS.md),
# and users on the mirror ran without fixes that shipped in the embedded copy.
# Prose alone did not hold this invariant, so it is checked here.
installer_script="Kannu/managers/AgentStatus/AgentHookInstaller.swift"
mirror_script="scripts/kannu-agent-status.sh"
# The INDEX, not the working tree: a check that reads the file on disk validates something other
# than what is being committed (stage a drifted mirror, keep a matching copy unstaged, and the old
# check passed). A file not in the index falls back to the working copy.
committed() { git show ":$1" 2>/dev/null || cat "$1"; }
# Gate on the index as well: a drifted script staged and then deleted from the working tree (the
# deletion unstaged) is still what gets committed, and a working-tree gate skipped every check.
in_index() { git cat-file -e ":$1" 2>/dev/null; }
# Read each committed copy ONCE, into a variable, and run every grep/awk/sed below on that variable
# (here-strings: no writer process). Never pipe `committed` or `git show` into a reader that can stop
# before the end (awk with exit, head, grep -q or -m): the reader closes the pipe while git is still
# writing the ~175 KB installer, git takes SIGPIPE, the `|| cat` fallback writes into the same closed
# pipe, and pipefail + errexit end the hook with exit 1 and nothing but "cat: ...: Broken pipe". It is
# a race, so CI failed now and then on an unchanged tree (docs/REGRESSIONS.md entry 25).
usage_mirror_script="scripts/kannu-usage-status.sh"
installer_text=""
mirror_text=""
usage_mirror_text=""
if in_index "${installer_script}"; then installer_text="$(committed "${installer_script}")"; fi
if in_index "${mirror_script}"; then mirror_text="$(committed "${mirror_script}")"; fi
if in_index "${usage_mirror_script}"; then usage_mirror_text="$(committed "${usage_mirror_script}")"; fi
# The first match of an extended regex in a string, or nothing. Replaces `grep -o | head -1`.
first_match() { local re="$2"; if [[ "$1" =~ ${re} ]]; then printf '%s' "${BASH_REMATCH[0]}"; fi; }
if in_index "${installer_script}" && in_index "${mirror_script}"; then
  installer_version="$(first_match "${installer_text}" 'KANNU_HOOK_SCRIPT_VERSION=[0-9]*')"
  mirror_version="$(first_match "${mirror_text}" 'KANNU_HOOK_SCRIPT_VERSION=[0-9]*')"
  if [[ -n "${installer_version}" && "${installer_version}" != "${mirror_version}" ]]; then
    cat <<EOF
ERROR: Hook script mirror is out of sync.

  embedded (authoritative): ${installer_version}  in ${installer_script}
  mirror:                   ${mirror_version:-<none>}  in ${mirror_script}

The mirror is what scripts/install-cursor-hooks.sh gives users. Regenerate it from
the embedded copy so both carry the same version, then re-stage it.
See docs/REGRESSIONS.md for why this check exists.
EOF
    exit 1
  fi
fi

# --- Hook-script body parity and the no-backslash rule -------------------------
# The markers above only catch a missing version bump. The bodies must be byte-identical too
# (after the embedded copy's 8-space indent), and the Python must contain no backslash: the
# embedded copy is a plain Swift string literal, where "\n" becomes a newline and "\U" does not
# compile. Build code points with chr(). See docs/REGRESSIONS.md entry 1.
if in_index "${installer_script}" && in_index "${mirror_script}"; then
  mirror_body="$(awk "/^python3 <<'PY'\$/{f=1;next} /^PY\$/{f=0} f" <<< "${mirror_text}")"
  if [[ "${mirror_body}" == *\\* ]]; then
    echo "ERROR: ${mirror_script} has a backslash in its Python body. The embedded Swift literal cannot carry one; use chr()."
    exit 1
  fi
  installer_marker="$(first_match "${installer_text}" 'KANNU_HOOK_SCRIPT_VERSION=[0-9]*')"
  # awk stops at the closing quotes; it reads a here-string, so no writer is left mid-write.
  embedded_body="$(awk '/let script = """$/ && !seen {seen=1; f=1; next} f && /^        """$/ {exit} f' <<< "${installer_text}" \
    | sed -e 's/^        //' -e "s/\\\\(scriptVersionMarker)/${installer_marker}/")"
  if [[ "${embedded_body}" != "${mirror_text}" ]]; then
    cat <<EOF
ERROR: the hook script body in ${installer_script} differs from ${mirror_script}.

Regenerate the embedded copy from the mirror (8-space indent, marker line replaced by the
interpolation), then re-stage both. See docs/REGRESSIONS.md entry 1.
EOF
    exit 1
  fi
fi
# The Claude statusline script has the same two-copy shape (writeUsageScript embeds it,
# scripts/kannu-usage-status.sh mirrors it) and drifted unnoticed until v4 because only the
# agent-status pair was checked. Same rule, same fix.
if in_index "${installer_script}" && in_index "${usage_mirror_script}"; then
  usage_installer_version="$(first_match "${installer_text}" 'KANNU_USAGE_SCRIPT_VERSION=[0-9]*')"
  usage_mirror_version="$(first_match "${usage_mirror_text}" 'KANNU_USAGE_SCRIPT_VERSION=[0-9]*')"
  if [[ -n "${usage_installer_version}" && "${usage_installer_version}" != "${usage_mirror_version}" ]]; then
    cat <<EOF
ERROR: Usage statusline script mirror is out of sync.

  embedded (authoritative): ${usage_installer_version}  in ${installer_script}
  mirror:                   ${usage_mirror_version:-<none>}  in ${usage_mirror_script}

Apply the same body edit to both copies and bump both markers, then re-stage.
See docs/REGRESSIONS.md entry 1 for why this check exists.
EOF
    exit 1
  fi
fi
# ------------------------------------------------------------------------------

# --- Notch tooltip invariants -------------------------------------------------
# SwiftUI's .help() compiles to NSView.toolTip, and AppKit only shows tooltips for the
# ACTIVE app. Kannu is LSUIElement with a non-activating notch panel, so it is never
# active and .help() is dead there — it silently does nothing. Eight call sites shipped
# that way. Use .hoverTooltip(...) instead (docs/TOOLTIPS.md).
# The scan covers every folder whose views render in the notch or its fitted panels. It
# once covered only Notch/ and AgentStatus/, and a .help() shipped in Timer/ unseen
# (docs/REGRESSIONS.md entry 9). KannuTests/NotchTooltipCoverageRulesTests lists the
# same eight folders and also requires a tooltip on every icon-only button.
# Strip the file:line: prefix before testing for a comment, or the doc comments that
# explain this very rule trip the check.
notch_view_dirs=(
  Kannu/components/Notch
  Kannu/components/AgentStatus
  Kannu/components/Music
  Kannu/components/Timer
  Kannu/components/Clipboard
  Kannu/components/Tabs
  Kannu/components/Shelf
  Kannu/components/Stats
)
dead_help="$(grep -rn '\.help(' "${notch_view_dirs[@]}" 2>/dev/null \
  | grep -vE '^[^:]+:[0-9]+:[[:space:]]*(//|\*)' || true)"
if [[ -n "${dead_help}" ]]; then
  cat <<EOF
ERROR: .help(...) found in a notch view (${notch_view_dirs[*]##*/}). It never renders there.

${dead_help}

Kannu is an accessory (LSUIElement) app whose notch is a non-activating panel, so the app
is never frontmost and AppKit's tooltip manager never runs. Use .hoverTooltip(...) instead.
See docs/TOOLTIPS.md.
EOF
  exit 1
fi

# The bubble is an overlay, so a relaxed horizontal axis makes it adopt the PARENT's width
# — typically a ~14pt icon button — and it renders invisibly. `.fixedSize()` on both axes
# is what lets it size to its own text. Relaxing it broke every tooltip in the app once.
tooltip_file="Kannu/components/Notch/HoverTooltip.swift"
if [[ -f "${tooltip_file}" ]]; then
  if grep -q 'fixedSize(horizontal:' "${tooltip_file}"; then
    cat <<EOF
ERROR: ${tooltip_file} uses fixedSize(horizontal:...).

The tooltip is an overlay: relaxing the horizontal axis makes it lay out at the parent
control's width (often ~14pt) and disappear. Keep the bare .fixedSize().
See docs/TOOLTIPS.md.
EOF
    exit 1
  fi
  if ! grep -q '\.fixedSize()' "${tooltip_file}"; then
    echo "ERROR: ${tooltip_file} must keep .fixedSize() — see docs/TOOLTIPS.md."
    exit 1
  fi
fi
# --- Settings layout invariant -------------------------------------------------
# A Section header or footer built as a raw Text cannot be selected or copied; the shared
# SettingsSectionHeader / SettingsFooter components exist so it can. Full rules:
# docs/SETTINGS.md; the real gate is KannuTests/SettingsLayoutRulesTests (no CI job runs
# this hook). Reads the index, like every check here.
settings_offender=$(git diff --cached --name-only -- 'Kannu/components/Settings/*.swift' | while read -r f; do
  git show ":${f}" 2>/dev/null | awk -v file="${f}" '
    { trimmed = $0; sub(/^[[:space:]]+/, "", trimmed) }
    trimmed ~ /^\/\// { prev = ""; next }
    /header: \{[[:space:]]*Text\(/ || /footer: \{[[:space:]]*Text\(/ { print file ": " trimmed }
    prev ~ /(header|footer): \{[[:space:]]*$/ && trimmed ~ /^Text\(/ { print file ": " trimmed }
    { prev = $0 }
  '
done)
if [[ -n "${settings_offender}" ]]; then
  cat <<EOF
ERROR: a Settings Section header/footer is a raw Text — it cannot be selected.
Use SettingsSectionHeader / SettingsFooter instead. See docs/SETTINGS.md.
${settings_offender}
EOF
  exit 1
fi

# --- Modal presentation invariant ---------------------------------------------
# A file panel's runModal() stops the main run loop, and this app keeps publishing on the
# main queue while it is stopped, so SwiftUI re-enters layout underneath the modal session.
# A user clicked the ADR policy picker and the app froze: the main thread was parked in
# -[NSSavePanel runModal] with the panel out of reach. beginSheetModal is the other half —
# nearly every window Kannu owns is a borderless non-activating panel at .mainMenu + 3, and
# a sheet on one of those cannot be focused or moved aside.
# Both APIs live in ModalPresenter and nowhere else. Strip the file:line: prefix before
# testing for a comment, or the doc comments explaining this rule trip the check.
# No trailing "(" on runModal: `panel.runModal ()` is valid Swift that calls the method, and a
# pattern ending in "(" walked straight past it. beginSheet(/beginCriticalSheet are NSWindow's own
# spelling of the same mistake.
modal_helper="Kannu/helpers/ModalPresenter.swift"
# `git grep --cached`: the index, not the working tree. `/\*` joins the comment exemption so the two
# copies of this rule (here and ModalPresentationRulesTests) agree.
stray_modal="$(git grep --cached -nE 'runModal|beginSheetModal|beginSheet\(|beginCriticalSheet|beginModalSession' -- Kannu 2>/dev/null \
  | grep -v "^${modal_helper}:" \
  | grep -vE '^[^:]+:[0-9]+:[[:space:]]*(//|\*|/\*)' || true)"
if [[ -n "${stray_modal}" ]]; then
  cat <<EOF
ERROR: runModal()/beginSheetModal outside ${modal_helper}.

${stray_modal}

runModal() on a file panel freezes the app (a nested modal run loop with SwiftUI still
publishing on the main queue), and a sheet anchored to one of Kannu's non-activating notch
panels cannot be reached. Present through ModalPresenter instead:

  ModalPresenter.present(panel) { response in ... }   // open/save panels, never modal
  ModalPresenter.present(alert) { response in ... }   // sheet when a window is up
  ModalPresenter.runAppModal(alert)                   // only when the answer is needed now

KannuTests/ModalPresentationRulesTests.swift pins the same rule for CI.
EOF
  exit 1
fi
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------

# Every file that documents the CHANGELOG entry shape must carry the literal keys this hook
# greps for further down. An unpinned copy is how .agents/.../SKILL.md and
# .cursor/rules/feature-changelog.mdc both came to describe a shape the hook rejects, so every
# agent following them wrote commits that could not land. KannuTests/ChangelogRuleDocsTests.swift
# runs the stronger version of this check (inside the fenced template, de-indented) in CI; this is
# the millisecond tripwire.
for doc in CONTRIBUTING.md AGENTS.md .agents/skills/kannu-senior-contributor/SKILL.md .cursor/rules/feature-changelog.mdc; do
  # Read the INDEX, not the working tree. Staging a template with a key deleted and then restoring
  # that key as an unstaged edit would otherwise pass this check while committing the broken file.
  # Every other check in this hook reads the index; this one used to be the exception.
  git cat-file -e ":${doc}" 2>/dev/null || continue
  # Read once, then grep the variable: grep -q stops at its first match, and a `git show |` still
  # writing would take SIGPIPE and read as a missing key (entry 25).
  doc_text="$(git show ":${doc}")"
  for key in '- \*\*Developer label:\*\*' '- \*\*Agent label:\*\*' '- \*\*Changes:\*\*'; do
    # -e is required: every key starts with "-", which grep would read as an option.
    if ! grep -q -e "${key}" <<< "${doc_text}"; then
      echo "ERROR: ${doc} documents the CHANGELOG entry but is missing the literal '${key}'."
      echo "       This hook greps for it; a file that says otherwise makes agents write rejected commits."
      exit 1
    fi
  done
done

staged_files="$(git diff --cached --name-only --diff-filter=ACMR)"
if [[ -z "${staged_files}" ]]; then
  exit 0
fi

has_source_change=false
while IFS= read -r file; do
  [[ -z "${file}" ]] && continue
  if [[ "${file}" =~ ^Kannu/ ]] \
    || [[ "${file}" =~ ^scripts/ ]] \
    || [[ "${file}" =~ \.xcodeproj/ ]] \
    || [[ "${file}" == "CONTRIBUTING.md" ]] \
    || [[ "${file}" == "ReadMe.md" ]] \
    || [[ "${file}" == "README.md" ]] \
    || [[ "${file}" =~ ^\.cursor/rules/ ]] \
    || [[ "${file}" == "AGENTS.md" ]] \
    || [[ "${file}" == "CLAUDE.md" ]]; then
    has_source_change=true
    break
  fi
done <<< "${staged_files}"

if [[ "${has_source_change}" != "true" ]]; then
  exit 0
fi

if ! grep -qx 'CHANGELOG.md' <<< "${staged_files}"; then
  cat <<'EOF'
ERROR: Missing staged CHANGELOG update.

When source files change, stage CHANGELOG.md with a new entry under [Unreleased]:

### YYYY-MM-DD - <developer-feature-label>
- **Developer label:** <label>
- **Agent label:** <label>
- **Changes:**
  - <one concrete change>
EOF
  exit 1
fi

changelog_content="$(git show :CHANGELOG.md 2>/dev/null || true)"
if [[ -z "${changelog_content}" ]]; then
  echo "ERROR: Could not read staged CHANGELOG.md."
  exit 1
fi

# awk must NOT exit early here: it would close the pipe while printf is still writing the
# ~78 KB changelog, printf would take SIGPIPE, and pipefail+errexit would abort the hook with
# exit 141 before any check ran. Read to EOF and gate with a flag instead.
unreleased_section="$(printf '%s\n' "${changelog_content}" | awk '
  /^## \[Unreleased\]/ { in_section=1; next }
  /^## \[/ { if (in_section) { in_section=0; done=1 } }
  in_section && !done { print }
')"

# Use grep, not "${var//[[:space:]]/}": that expansion is superlinear in bash 3.2
# (macOS's /bin/bash) and the Unreleased section is already ~78 KB, which made this
# check run for many minutes and effectively blocked every commit.
if ! grep -q '[^[:space:]]' <<< "${unreleased_section}"; then
  echo "ERROR: CHANGELOG.md must include a populated ## [Unreleased] section."
  exit 1
fi

# Same SIGPIPE rule as above: no early exit.
latest_entry="$(printf '%s\n' "${unreleased_section}" | awk '
  /^### / {
    if (found) done=1
    found=1
  }
  found && !done { print }
')"

if ! grep -q '[^[:space:]]' <<< "${latest_entry}"; then
  echo "ERROR: Add a latest entry heading under ## [Unreleased] (### YYYY-MM-DD - ...)."
  exit 1
fi

if ! grep -q '^- \*\*Developer label:\*\*' <<< "${latest_entry}"; then
  echo "ERROR: Latest changelog entry is missing '- **Developer label:**'."
  exit 1
fi

if ! grep -q '^- \*\*Agent label:\*\*' <<< "${latest_entry}"; then
  echo "ERROR: Latest changelog entry is missing '- **Agent label:**'."
  exit 1
fi

if ! grep -q '^- \*\*Changes:\*\*' <<< "${latest_entry}"; then
  echo "ERROR: Latest changelog entry is missing '- **Changes:**'."
  exit 1
fi

has_change_bullet="$(printf '%s\n' "${latest_entry}" | awk '
  BEGIN { in_changes=0; has_bullet=0 }
  /^- \*\*Changes:\*\*/ { in_changes=1; next }
  /^- \*\*/ { if (in_changes) in_changes=0 }
  /^### / { if (in_changes) in_changes=0 }
  {
    if (in_changes && $0 ~ /^  - /) {
      has_bullet=1
    }
  }
  END {
    if (has_bullet) print "true"
    else print "false"
  }
')"

if [[ "${has_change_bullet}" != "true" ]]; then
  echo "ERROR: Latest changelog entry must include at least one indented bullet under Changes."
  exit 1
fi

exit 0
